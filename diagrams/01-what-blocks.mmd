flowchart LR
    subgraph M["Monitor"]
        direction TB
        M1["Agent reports flows"] --> M2["Cluster evaluates policy<br/>against live traffic"]
        M2 --> M3["Reports what would be rejected"]
        M4["Host firewall unchanged"]
        M5["Nothing is blocked"]
    end
    subgraph S["Simulate"]
        direction TB
        S1["Rules pre-staged on the host<br/>where the release supports it"] --> S2["Agent reports would-be-rejected<br/>from its own view"]
        S3["Actions are suppressed"]
        S4["Nothing is blocked"]
    end
    subgraph E["Enforce"]
        direction TB
        E1["Host firewall enforces the rules"] --> E2["Non-matching flows are dropped<br/>per the Catch-All"]
        E3["This is the only phase<br/>that blocks traffic"]
    end
    M ==> S ==> E
